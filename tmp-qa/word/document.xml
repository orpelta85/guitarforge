Pr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="0B682308" wp14:editId="704D8C25"><wp:extent cx="5274310" cy="1048385"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="265175652" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="265175652" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="1048385"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="1386A022" w14:textId="3E97402F" w:rsidR="007E1EE7" w:rsidRPr="00164269" w:rsidRDefault="007E1EE7" w:rsidP="00C05CFA"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="cs"/><w:rtl/></w:rPr><w:t xml:space="preserve">בנוסף פה להוסיף את אחלון הברקינג טראק לקרוא לזה ג'אם מהיר אפשר לשכלל את זה לעשות דיפולט באמת שזה ימשוך מהמיקוד השבועי או אפשרות לחיפוש באקינג טראק וזה יפתח חלון פנימי(כמו בתרגילים) של יו טיוב. אפשר לבנות פה משהו חכם ונוח יותר אולי תיע משו הרעיון שאנייכוןל לפוח וישר לייצר לי באקינד טראק או לפי הנחיות שאני אתם לו כמו סגנון סולם אולי שדות בחירה תעשה לי שיהיה קל ואז אתה מוסיף לו לחיפוש כמו בתררגלים את הבאקינג טראק וזה ישלוף את הראשון אוטומטית מיוטיוב עם כפתור חפש עוד כמו עשינו קודם. בנוסף לעשות ייצר באמצעות סונו וגם שם שימשוך מאותה שדות בחירה </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="cs"/><w:rtl/></w:rPr><w:lastRenderedPageBreak/><w:t>את הטקסט של סגנון, סולם, אמן וכו'</w:t></w:r><w:r><w:rPr><w:rtl/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4B8627D6" wp14:editId="0FB5D26D"><wp:extent cx="5274310" cy="753745"/><wp:effectExtent l="0" t="0" r="2540" b="8255"/><wp:docPr id="1771367545" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1771367545" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="753745"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="037E946C" w14:textId="24F078EE" w:rsidR="007E1EE7" w:rsidRDefault="007E1EE7" w:rsidP="007E1EE7"><w:pPr><w:rPr><w:rtl/></w:rPr></w:pPr><w:r><w:rPr><w:rtl/></w:rPr><w:br/></w:r><w:r><w:rPr><w:rFonts w:hint="cs"/><w:rtl/></w:rPr><w:t>עמוד אימון פרקטיס</w:t></w:r></w:p><w:p w14:paraId="3B24C7CA" w14:textId="187805EB" w:rsidR="007E1EE7" w:rsidRDefault="007E1EE7" w:rsidP="007E1EE7"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="cs"/><w:rtl/></w:rPr><w:t>שאני עושה מילוי אוטומטי זה ממלא רק תרגילי  חימום ולא את כל השאר שהקטגוריות בצורה חכמה ולפי זמן הנגניה שקבעתי</w:t></w:r><w:r><w:rPr><w:rtl/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4F87D1A6" 